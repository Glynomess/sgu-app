extends Control

@onready var camera_feed: TextureRect = $CameraFeed
@onready var camera_number: Label = $Header/CameraNumber
@onready var camera_location: Label = $Header/CameraLocation

var camera_viewport: SubViewport
var render_camera: Camera3D

var cameras: Array[Camera3D] = []

var camera_names: Array[String] = [
	"Main Hall",
	"School Corridor",
	"First Floor",
	"Second Floor",
	"Classroom 01",
	"Classroom 02",
	"Generator Room",
	"Back Entrance"
]

var active_camera_index: int = -1
var switching: bool = false
var static_overlay: ColorRect


func _ready() -> void:
	var viewport_node := get_node_or_null(
		"../SubViewportContainer/CameraViewport"
	)

	if not viewport_node is SubViewport:
		push_warning("CameraViewport not found.")
		return

	camera_viewport = viewport_node as SubViewport

	render_camera = camera_viewport.get_node_or_null(
		"RenderCamera"
	) as Camera3D

	if render_camera == null:
		push_warning("RenderCamera not found.")
		return

	camera_viewport.world_3d = get_viewport().world_3d
	camera_feed.texture = camera_viewport.get_texture()

	var main_scene := get_tree().current_scene

	# Находим все восемь камер.
	for i in range(8):
		var camera_path := (
			"School/SecurityCamera%02d/Camera3D" % (i + 1)
		)

		var camera := main_scene.get_node_or_null(
			camera_path
		) as Camera3D

		cameras.append(camera)

		if camera == null:
			print("CAM %02d пока не подключена." % (i + 1))
		else:
			print("CAM %02d подключена." % (i + 1))

	_create_static_overlay()
	_connect_camera_buttons()

	camera_viewport.render_target_update_mode = (
		SubViewport.UPDATE_ALWAYS
	)

	var first_camera := _find_first_available_camera()

	if first_camera == -1:
		push_warning("Не найдена ни одна камера.")
		return

	_select_camera_immediately(first_camera)


func _find_first_available_camera() -> int:
	for i in range(cameras.size()):
		if cameras[i] != null:
			return i

	return -1


func _connect_camera_buttons() -> void:
	for i in range(8):
		var button := get_node_or_null(
			"CameraList/Camera%02d" % (i + 1)
		) as Button

		if button == null:
			push_warning(
				"Не найдена кнопка Camera%02d." % (i + 1)
			)
			continue

		button.pressed.connect(
			_on_camera_button_pressed.bind(i)
		)

		button.disabled = cameras[i] == null


func _on_camera_button_pressed(index: int) -> void:
	if switching:
		return

	if index < 0 or index >= cameras.size():
		return

	if cameras[index] == null:
		print("Эта камера пока не подключена.")
		return

	if index == active_camera_index:
		return

	await _switch_camera(index)


func _switch_camera(index: int) -> void:
	switching = true

	# Показываем процедурные помехи.
	static_overlay.show()
	static_overlay.modulate.a = 0.0

	var fade_in := create_tween()
	fade_in.tween_property(
		static_overlay,
		"modulate:a",
		1.0,
		0.10
	)

	await fade_in.finished

	# Переключаем источник изображения.
	render_camera.source_camera = cameras[index]

	active_camera_index = index

	_update_camera_info(index)
	_update_button_highlights(index)

	# Короткая задержка перед проявлением изображения.
	await get_tree().create_timer(
		randf_range(0.25, 0.45)
	).timeout

	# Ослабляем помехи, чтобы изображение стало видно.
	var reveal := create_tween()
	reveal.tween_property(
		static_overlay,
		"modulate:a",
		0.35,
		0.35
	)

	await reveal.finished

	# Оставляем остаточные помехи.
	await get_tree().create_timer(1.0).timeout

	# Плавно убираем оставшийся шум.
	var fade_out := create_tween()
	fade_out.tween_property(
		static_overlay,
		"modulate:a",
		0.0,
		0.45
	)

	await fade_out.finished

	static_overlay.hide()
	static_overlay.modulate.a = 1.0

	switching = false


func _select_camera_immediately(index: int) -> void:
	render_camera.source_camera = cameras[index]

	active_camera_index = index

	_update_camera_info(index)
	_update_button_highlights(index)


func _update_camera_info(index: int) -> void:
	camera_number.text = "CAM %02d" % (index + 1)
	camera_location.text = camera_names[index]


func _update_button_highlights(index: int) -> void:
	for i in range(8):
		var button := get_node_or_null(
			"CameraList/Camera%02d" % (i + 1)
		) as Button

		if button == null:
			continue

		if cameras[i] == null:
			button.disabled = true
			button.modulate = Color(
				0.45, 0.45, 0.45, 1.0
			)
		else:
			button.disabled = false

			if i == index:
				button.modulate = Color(
					0.55, 1.0, 0.55, 1.0
				)
			else:
				button.modulate = Color.WHITE


func _create_static_overlay() -> void:
	static_overlay = ColorRect.new()
	static_overlay.name = "StaticOverlay"

	static_overlay.set_anchors_and_offsets_preset(
		Control.PRESET_FULL_RECT
	)

	static_overlay.mouse_filter = (
		Control.MOUSE_FILTER_IGNORE
	)

	var noise_shader := Shader.new()

	noise_shader.code = """
shader_type canvas_item;

float hash(vec2 p) {
	return fract(
		sin(dot(p, vec2(127.1, 311.7)))
		* 43758.5453
	);
}

void fragment() {
	vec2 pixel = floor(UV * vec2(320.0, 180.0));

	float noise = hash(
		pixel + vec2(TIME * 173.0, TIME * 91.0)
	);

	float lines = step(
		0.94,
		hash(vec2(pixel.y, TIME * 20.0))
	);

	float value = clamp(
		noise * 0.8 + lines * 0.5,
		0.0,
		1.0
	);

	COLOR = vec4(vec3(value), 1.0);
}
"""

	var shader_material := ShaderMaterial.new()
	shader_material.shader = noise_shader

	static_overlay.material = shader_material

	camera_feed.add_child(static_overlay)
	static_overlay.hide()
