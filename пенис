extends CharacterBody3D

@export var walk_speed: float = 4.0
@export var crouch_speed: float = 1.5
@export var mouse_sensitivity: float = 0.002
var gravity: float = 20.0

@export var stand_height: float = 1.6
@export var crouch_height: float = 0.9
@export var seat_camera_height: float = 0.75
@export var hide_camera_height: float = 0.3
@export var chair_interaction_distance: float = 1.8
@export var door_interaction_distance: float = 3.0
@export var hide_interaction_distance: float = 2.5
@export var hide_yaw_limit_deg: float = 45.0
@export_range(0.8, 1.0, 0.01) var peek_exit_screen_height: float = 0.92

@export var seat_anchor_path: NodePath = ^"../SeatAnchor"
@export var window_aim_path: NodePath = ^"../WindowAim"
@export var monitor_aim_path: NodePath = ^"../MonitorAim"
@export var door_aim_path: NodePath = ^"../DoorAim"
@export var peek_anchor_path: NodePath = ^"../PeekAnchor"
@export var hide_anchor_path: NodePath = ^"../HideAnchor"

@export var zone_switch_cooldown: float = 0.2

enum PlayerMode { WALKING, PEEKING, SEATED, HIDDEN }
enum SeatedZone { MONITOR, WINDOW, DOOR }
var mode: PlayerMode = PlayerMode.WALKING

var is_crouching: bool = false
var _peek_ready_to_exit: bool = false
var _peek_exit_in_progress: bool = false
var _peek_camera_position: Vector3
var _peek_camera_rotation: Vector3
var _peek_player_transform: Transform3D
var _walking_camera_position: Vector3
var _walking_camera_rotation: Vector3
var _walking_transform: Transform3D
var _crouch_tween: Tween
var _current_zone: SeatedZone = SeatedZone.WINDOW
var _zone_tween: Tween
var _zone_switch_timer: float = 0.0
var _hide_yaw: float = 0.0
var _hide_exit_in_progress: bool = false

@onready var camera: Camera3D = $Camera3D
@onready var seat_anchor: Marker3D = get_node(seat_anchor_path)
@onready var window_aim: Marker3D = get_node(window_aim_path)
@onready var monitor_aim: Marker3D = get_node(monitor_aim_path)
@onready var door_aim: Marker3D = get_node(door_aim_path)
@onready var peek_anchor: Marker3D = get_node(peek_anchor_path)
@onready var hide_anchor: Marker3D = get_node(hide_anchor_path)
@onready var door: SecurityDoor = get_node("../Door")
@onready var chair: Node3D = get_node("../Furniture/task_chair")

func _ready() -> void:
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	camera.position.y = stand_height - 0.3

func _input(event: InputEvent) -> void:
	if _is_fresh_action_press(event, "ui_cancel"):
		if mode == PlayerMode.WALKING:
			Input.mouse_mode = Input.MOUSE_MODE_VISIBLE if Input.mouse_mode == Input.MOUSE_MODE_CAPTURED else Input.MOUSE_MODE_CAPTURED
		return

	if mode == PlayerMode.WALKING:
		if event is InputEventMouseMotion and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED:
			rotate_y(-event.relative.x * mouse_sensitivity)
			camera.rotate_x(-event.relative.y * mouse_sensitivity)
			camera.rotation.x = clamp(camera.rotation.x, deg_to_rad(-89), deg_to_rad(89))

		if event.is_action_pressed("crouch"):
			_set_crouch(true)
		elif event.is_action_released("crouch"):
			_set_crouch(false)

		if _is_fresh_action_press(event, "interact"):
			_interact_while_walking()
		elif _is_fresh_action_press(event, "hide"):
			if _is_near_hide_spot():
				_enter_hide()
		elif _is_fresh_action_press(event, "door_full_open"):
			if _is_door_available():
				door.toggle_full_open()
		elif _is_fresh_action_press(event, "door_lock"):
			if _is_door_available():
				door.toggle_lock()
		elif event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.pressed and Input.mouse_mode == Input.MOUSE_MODE_VISIBLE:
			Input.mouse_mode = Input.MOUSE_MODE_CAPTURED

	elif mode == PlayerMode.PEEKING:
		pass

	elif mode == PlayerMode.SEATED:
		if _is_fresh_action_press(event, "interact"):
			_exit_seat()
		elif event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
			_activate_seated_zone()

	elif mode == PlayerMode.HIDDEN:
		if _is_fresh_action_press(event, "hide"):
			if not _hide_exit_in_progress:
				_exit_hide()
		elif event is InputEventMouseMotion and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED and not _hide_exit_in_progress:
			_update_hide_look(event.relative)

func _process(delta: float) -> void:
	if mode == PlayerMode.PEEKING and _peek_ready_to_exit and not _peek_exit_in_progress:
		var mouse_position: Vector2 = get_viewport().get_mouse_position()
		var viewport_height: float = get_viewport().get_visible_rect().size.y
		if mouse_position.y >= viewport_height * peek_exit_screen_height:
			_leave_peek()

	if mode == PlayerMode.SEATED:
		_update_seated_zone(delta)

func _physics_process(delta: float) -> void:
	if mode != PlayerMode.WALKING:
		velocity = Vector3.ZERO
		return

	if not is_on_floor():
		velocity.y -= gravity * delta

	var input_dir: Vector2 = Input.get_vector("move_left", "move_right", "move_forward", "move_back")
	var direction: Vector3 = (transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()
	var speed: float = crouch_speed if is_crouching else walk_speed

	if direction:
		velocity.x = direction.x * speed
		velocity.z = direction.z * speed
	else:
		velocity.x = move_toward(velocity.x, 0, speed)
		velocity.z = move_toward(velocity.z, 0, speed)

	move_and_slide()

func _interact_while_walking() -> void:
	if _is_near_chair():
		_enter_seat()
		return

	if _is_looking_at_door():
		var should_peek: bool = door.interact()
		if should_peek:
			_start_peek()
		return

func _enter_seat() -> void:
	_stop_crouch_tween()
	_walking_transform = global_transform
	_walking_camera_position = camera.position
	_walking_camera_position.y = stand_height - 0.3
	_walking_camera_rotation = camera.rotation
	mode = PlayerMode.SEATED
	velocity = Vector3.ZERO
	is_crouching = false
	global_position = seat_anchor.global_position
	global_rotation.y = seat_anchor.global_rotation.y
	camera.position.y = seat_camera_height
	_current_zone = SeatedZone.WINDOW
	_zone_switch_timer = 0.0
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	Input.warp_mouse(get_viewport().get_visible_rect().size * 0.5)
	_aim_at_current_zone(true)

func _exit_seat() -> void:
	if _zone_tween and _zone_tween.is_running():
		_zone_tween.kill()
	global_transform = _walking_transform
	camera.position = _walking_camera_position
	camera.rotation = _walking_camera_rotation
	mode = PlayerMode.WALKING
	velocity = Vector3.ZERO
	_zone_switch_timer = 0.0
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED

func _enter_hide() -> void:
	_stop_crouch_tween()
	_walking_transform = global_transform
	_walking_camera_position = camera.position
	_walking_camera_position.y = stand_height - 0.3
	_walking_camera_rotation = camera.rotation
	mode = PlayerMode.HIDDEN
	velocity = Vector3.ZERO
	is_crouching = false
	_hide_yaw = 0.0
	_hide_exit_in_progress = false

	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED

	var tween := create_tween().set_parallel(true)
	tween.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tween.tween_property(self, "global_transform", hide_anchor.global_transform, 0.6)
	tween.tween_property(camera, "position", Vector3(0, hide_camera_height, 0), 0.6)
	tween.tween_property(camera, "rotation", Vector3.ZERO, 0.6)

func _exit_hide() -> void:
	if _hide_exit_in_progress:
		return
	_hide_exit_in_progress = true

	var tween := create_tween().set_parallel(true)
	tween.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tween.tween_property(self, "global_transform", _walking_transform, 0.5)
	tween.tween_property(camera, "position", _walking_camera_position, 0.5)
	tween.tween_property(camera, "rotation", _walking_camera_rotation, 0.5)

	await tween.finished
	if mode == PlayerMode.HIDDEN:
		mode = PlayerMode.WALKING
		velocity = Vector3.ZERO
		_hide_yaw = 0.0
		_hide_exit_in_progress = false

func _update_hide_look(relative: Vector2) -> void:
	_hide_yaw -= relative.x * mouse_sensitivity
	var limit: float = deg_to_rad(hide_yaw_limit_deg)
	_hide_yaw = clamp(_hide_yaw, -limit, limit)

	var target_rot: Vector3 = Vector3(
		camera.rotation.x - relative.y * mouse_sensitivity,
		_hide_yaw,
		0.0
	)
	target_rot.x = clamp(target_rot.x, deg_to_rad(-60), deg_to_rad(60))
	camera.rotation = target_rot

func _is_near_hide_spot() -> bool:
	return global_position.distance_to(hide_anchor.global_position) <= hide_interaction_distance

func _start_peek() -> void:
	_stop_crouch_tween()
	mode = PlayerMode.PEEKING
	velocity = Vector3.ZERO
	_peek_ready_to_exit = false
	_peek_exit_in_progress = false
	_peek_player_transform = global_transform
	_peek_camera_position = camera.position
	_peek_camera_rotation = camera.rotation
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	Input.warp_mouse(get_viewport().get_visible_rect().size * 0.5)

	var tween := create_tween().set_parallel(true)
	tween.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tween.tween_property(self, "global_transform", peek_anchor.global_transform, 0.45)
	tween.tween_property(camera, "position", Vector3.ZERO, 0.45)
	tween.tween_property(camera, "rotation", Vector3.ZERO, 0.45)
	_play_peek_animation(tween)

func _play_peek_animation(tween: Tween) -> void:
	await tween.finished
	if mode == PlayerMode.PEEKING:
		_peek_ready_to_exit = true

func _leave_peek() -> void:
	_peek_exit_in_progress = true
	_peek_ready_to_exit = false
	var tween := create_tween().set_parallel(true)
	tween.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tween.tween_property(self, "global_transform", _peek_player_transform, 0.25)
	tween.tween_property(camera, "position", _peek_camera_position, 0.25)
	tween.tween_property(camera, "rotation", _peek_camera_rotation, 0.25)
	await tween.finished
	if mode == PlayerMode.PEEKING:
		mode = PlayerMode.WALKING
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	if door and door.state == SecurityDoor.DoorState.AJAR:
		door.set_state(SecurityDoor.DoorState.CLOSED)

func _is_near_chair() -> bool:
	return global_position.distance_to(chair.global_position) <= chair_interaction_distance

func _is_door_available() -> bool:
	return mode == PlayerMode.WALKING and global_position.distance_to(door.global_position) <= door_interaction_distance and _is_looking_at_door()

func _is_looking_at_door() -> bool:
	var origin: Vector3 = camera.global_position
	var end: Vector3 = origin - camera.global_basis.z * door_interaction_distance
	var query := PhysicsRayQueryParameters3D.create(origin, end)
	query.exclude = [get_rid()]
	var result: Dictionary = get_world_3d().direct_space_state.intersect_ray(query)
	return not result.is_empty() and result.get("collider") == door

func _update_seated_zone(delta: float) -> void:
	if _zone_switch_timer > 0.0:
		_zone_switch_timer = maxf(0.0, _zone_switch_timer - delta)
		return

	var viewport_width: float = get_viewport().get_visible_rect().size.x
	var edge_width: float = clampf(viewport_width * 0.05, 32.0, 80.0)
	var mouse_x: float = get_viewport().get_mouse_position().x

	var at_left_edge: bool = mouse_x <= edge_width
	var at_right_edge: bool = mouse_x >= viewport_width - edge_width

	if not (at_left_edge or at_right_edge):
		return

	var next_zone: SeatedZone = _zone_from_mouse_x(mouse_x)
	if next_zone != _current_zone:
		_current_zone = next_zone
		_aim_at_current_zone()
		_zone_switch_timer = zone_switch_cooldown

func _zone_from_mouse_x(mouse_x: float) -> SeatedZone:
	var viewport_width: float = get_viewport().get_visible_rect().size.x
	var edge_width: float = clampf(viewport_width * 0.05, 32.0, 80.0)

	match _current_zone:
		SeatedZone.WINDOW:
			if mouse_x <= edge_width:
				return SeatedZone.MONITOR
			if mouse_x >= viewport_width - edge_width:
				return SeatedZone.DOOR
		SeatedZone.MONITOR:
			if mouse_x >= viewport_width - edge_width:
				return SeatedZone.WINDOW
		SeatedZone.DOOR:
			if mouse_x <= edge_width:
				return SeatedZone.WINDOW

	return _current_zone

func _aim_at_current_zone(instant: bool = false) -> void:
	var aim_target: Marker3D
	match _current_zone:
		SeatedZone.MONITOR:
			aim_target = monitor_aim
		SeatedZone.WINDOW:
			aim_target = window_aim
		_:
			aim_target = door_aim

	var target_world_rotation: Vector3 = camera.global_transform.looking_at(aim_target.global_position, Vector3.UP).basis.get_euler()
	var local_target_rotation := Vector3(
		target_world_rotation.x,
		wrapf(target_world_rotation.y - global_rotation.y, -PI, PI),
		0.0
	)
	if _zone_tween and _zone_tween.is_running():
		_zone_tween.kill()
	if instant:
		camera.rotation = local_target_rotation
	else:
		_zone_tween = create_tween()
		_zone_tween.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
		_zone_tween.tween_property(camera, "rotation", local_target_rotation, 0.25)

func _activate_seated_zone() -> void:
	pass

func _notification(what: int) -> void:
	if what == NOTIFICATION_APPLICATION_FOCUS_OUT and mode == PlayerMode.WALKING:
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	elif what == NOTIFICATION_APPLICATION_FOCUS_IN and mode == PlayerMode.WALKING:
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED

func _is_fresh_action_press(event: InputEvent, action: StringName) -> bool:
	if not event.is_action_pressed(action):
		return false
	return not (event is InputEventKey and (event as InputEventKey).echo)

func _stop_crouch_tween() -> void:
	if _crouch_tween and _crouch_tween.is_running():
		_crouch_tween.kill()

func _set_crouch(state: bool) -> void:
	if mode != PlayerMode.WALKING or is_crouching == state:
		return
	is_crouching = state
	_stop_crouch_tween()
	var target_y: float = (crouch_height if is_crouching else stand_height) - 0.3
	_crouch_tween = create_tween()
	_crouch_tween.tween_property(camera, "position:y", target_y, 0.15)